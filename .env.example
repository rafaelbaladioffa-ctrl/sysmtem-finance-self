# Aplicação
NODE_ENV=development
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
APP_CURRENCY=BRL

# PostgreSQL (use o nome do serviço `db` dentro do Compose)
DATABASE_URL=postgres://finance_app:change-me@db:5432/finance_app
POSTGRES_DB=finance_app
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=change-me

# Worker
WORKER_PORT=3001
WORKER_POLL_INTERVAL_MS=5000

# Operação futura
DOCUMENTS_DIR=/var/lib/financas-casal/documents
ENABLE_OCR=false
ENABLE_AI=false
